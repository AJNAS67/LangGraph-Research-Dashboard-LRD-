# ==============================================================================
# LangGraph Research Dashboard (LRD) - Environment Configuration
# ==============================================================================

# Application Environment (development, staging, production)
APP_ENV=development
LOG_LEVEL=INFO

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
FRONTEND_URL=http://localhost:5173

# LLM Provider Configuration (OpenAI Compatible)
# Defaults to OpenAI, can be swapped for Anthropic, Groq, Ollama, Azure, etc.
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=your_openai_api_key_here

# Pluggable Web Search Tool Configuration
SEARCH_PROVIDER=tavily
TAVILY_API_KEY=your_tavily_api_key_here
SEARCH_MAX_RESULTS=5

# PostgreSQL & pgvector Database Configuration (Port 5433 to avoid host conflicts)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=lrd_db
POSTGRES_PORT=5433
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/lrd_db

# LangGraph Checkpointer Persistence
LANGGRAPH_CHECKPOINT_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/lrd_db

# Research Workflow Guardrails
MAX_RESEARCH_RETRIES=2
MAX_SUBTASKS=5
DEFAULT_SEARCH_DEPTH=standard
